  "meta": {
    "title": "ECharts可视化预处理数据",
    "version": "1.1",
    "created": "2026-03-23",
    "lastUpdated": "2026-03-23",
    "description": "为ECharts图表准备的标准化数据，包含雷达图、柱状图、饼图、时间轴、散点图、地图标注等",
    "dataSource": "bridges_master.json标准化主数据",
    "dataConsistency": "本文件数据与bridges_master.json保持同步"
  },
  "normalizationMethod": {
    "description": "数据归一化方法：min-max标准化，将原始数据映射到0-100范围",
    "formula": "各维度独立计算，确保得分在0-100范围内",
    "dimensionDetails": {
      "年代久远度": {
        "method": "反向计算（年代越久分数越高）",
        "formula": "normalized = (1700 - buildYear) / (1700 - 584) * 100",
        "range": "584年(隋)~1706年(清)",
        "note": "以建造年份计算，年代越久远分数越高，最高分100分"
      },
      "规模宏大度": {
        "method": "对数标准化（压缩长尾分布）",
        "formula": "normalized = log(length + 1) / log(2070 + 1) * 100",
        "range": "8.8米~2070米",
        "note": "使用对数标准化避免小桥得分为负，确保所有桥梁得分在0-100范围"
      },
      "技术创新度": {
        "method": "线性标准化",
        "formula": "normalized = leadYears / 1200 * 100",
        "range": "0~1200年领先",
        "note": "以领先世界年数计算，无领先记录的桥梁基于技术独特性评分"
      },
      "文化影响力": {
        "method": "专家评分",
        "range": "0~100分",
        "note": "综合知名度、历史事件、诗词数量、世界遗产地位评分"
      },
      "保存完整度": {
        "method": "专家评分",
        "range": "0~100分",
        "note": "综合保存状态、修缮情况、是否开放参观评分"
      }
    },
    "qualityNote": "所有维度得分已确保在0-100范围内，避免负值或超限问题"
  },

